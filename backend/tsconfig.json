/* created based on XDevNestServerApp, note: we probably do not need to have e.g. "node_modules" in "exclude" when we use "include" */
{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ESNext",
    "sourceMap": true,
    "outDir": "./lib",
    "rootDir": "./src",
    "incremental": true,
    "strictNullChecks": false,

    // for ESM
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "isolatedModules": true,
    "skipLibCheck": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "test", "lib", "**/*spec.ts"],
}